---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const papers = (await getCollection("papers")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Layout title={`${t.pages.papersTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.papersTitle} pageDesc={t.pages.papersDesc}>
    <ul>
      {
        papers.map(paper => (
          <li class="border-border my-6 border-b pb-6 last:border-none">
            <a
              href={paper.data.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              {paper.data.title}
            </a>
            {paper.data.authors && (
              <p class="text-muted-foreground text-sm">
                {paper.data.authors}
              </p>
            )}
            {paper.data.description && <p class="mt-2">{paper.data.description}</p>}
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
